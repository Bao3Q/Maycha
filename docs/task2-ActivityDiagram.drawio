<mxfile host="app.diagrams.net"><diagram name="ActivityDiagram" id="act1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="5540" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Activity Diagram – Luồng end-to-end BrewLite (Maycha): từ chọn món → giỏ hàng → đăng nhập → thanh toán không tiền mặt → xác nhận đơn" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=17;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2290" height="40" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=0;html=1;fillColor=#E3F2FD;strokeColor=#607D8B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="0" y="50" width="380" height="5420" as="geometry"/></mxCell><mxCell id="c4" value="Khách hàng" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#607D8B;strokeWidth=1.5;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="0" y="50" width="380" height="40" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=0;html=1;fillColor=#E8F5E9;strokeColor=#607D8B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="50" width="710" height="5420" as="geometry"/></mxCell><mxCell id="c6" value="Frontend (Next.js)" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#607D8B;strokeWidth=1.5;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="380" y="50" width="710" height="40" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=0;html=1;fillColor=#FFF3E0;strokeColor=#607D8B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1090" y="50" width="840" height="5420" as="geometry"/></mxCell><mxCell id="c8" value="Backend (NestJS)" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#607D8B;strokeWidth=1.5;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1090" y="50" width="840" height="40" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=0;html=1;fillColor=#F3E5F5;strokeColor=#607D8B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1930" y="50" width="360" height="5420" as="geometry"/></mxCell><mxCell id="c10" value="Cổng thanh toán (mock)" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#607D8B;strokeWidth=1.5;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1930" y="50" width="360" height="40" as="geometry"/></mxCell><mxCell id="c11" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="176" y="116" width="28" height="28" as="geometry"/></mxCell><mxCell id="c12" value="Mở ứng dụng Maycha" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="178" width="300" height="44" as="geometry"/></mxCell><mxCell id="c13" value="Gửi GET /products" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="268" width="290" height="44" as="geometry"/></mxCell><mxCell id="c14" value="Trả danh sách sản phẩm&lt;br&gt;(id, tên, giá, tồn kho)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1365" y="351" width="270" height="58" as="geometry"/></mxCell><mxCell id="c15" value="Hiển thị menu đồ uống" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="458" width="290" height="44" as="geometry"/></mxCell><mxCell id="c16" value="" style="rhombus;html=1;fillColor=#FFF8E1;strokeColor=#37474F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="178" y="548" width="24" height="24" as="geometry"/></mxCell><mxCell id="c17" value="Chọn món → mở màn hình chi tiết" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="608" width="300" height="44" as="geometry"/></mxCell><mxCell id="c18" value="Chọn size (S/M/L) và topping" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="678" width="300" height="44" as="geometry"/></mxCell><mxCell id="c19" value="Nhấn &amp;quot;Thêm vào giỏ&amp;quot;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="748" width="300" height="44" as="geometry"/></mxCell><mxCell id="c20" value="Tính giá theo size/topping,&lt;br&gt;thêm vào giỏ (lưu localStorage),&lt;br&gt;tự tính tổng tiền" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="822" width="290" height="76" as="geometry"/></mxCell><mxCell id="c21" value="" style="rhombus;html=1;fillColor=#FFF8E1;strokeColor=#37474F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="178" y="890" width="24" height="24" as="geometry"/></mxCell><mxCell id="c22" value="Xem giỏ hàng và tổng tiền&lt;br&gt;(tăng/giảm số lượng, xóa món)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="931" width="300" height="58" as="geometry"/></mxCell><mxCell id="c23" value="Mua thêm&lt;br&gt;món khác?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="1020" width="240" height="100" as="geometry"/></mxCell><mxCell id="c24" value="Nhấn &amp;quot;Tiến hành thanh toán&amp;quot;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1168" width="300" height="44" as="geometry"/></mxCell><mxCell id="c25" value="Đã có JWT&lt;br&gt;trong trình duyệt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="415" y="1255" width="260" height="110" as="geometry"/></mxCell><mxCell id="c26" value="Chuyển tới /login?next=/?view=checkout&lt;br&gt;(giỏ hàng vẫn được giữ lại)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="1401" width="290" height="58" as="geometry"/></mxCell><mxCell id="c27" value="" style="rhombus;html=1;fillColor=#FFF8E1;strokeColor=#37474F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="533" y="1508" width="24" height="24" as="geometry"/></mxCell><mxCell id="c28" value="Nhập email + mật khẩu&lt;br&gt;(Đăng nhập hoặc Đăng ký)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1581" width="300" height="58" as="geometry"/></mxCell><mxCell id="c29" value="Gửi POST /auth/register (nếu đăng ký)&lt;br&gt;rồi POST /auth/login" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="1691" width="290" height="58" as="geometry"/></mxCell><mxCell id="c30" value="Kiểm tra email,&lt;br&gt;so khớp mật khẩu (bcrypt)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1365" y="1801" width="270" height="58" as="geometry"/></mxCell><mxCell id="c31" value="Xác thực&lt;br&gt;thành công?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1370" y="1905" width="260" height="110" as="geometry"/></mxCell><mxCell id="c32" value="Phát JWT (HS256, hiệu lực 1 giờ)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1365" y="2078" width="270" height="44" as="geometry"/></mxCell><mxCell id="c33" value="Lưu JWT, quay lại /?view=checkout" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="2178" width="290" height="44" as="geometry"/></mxCell><mxCell id="c34" value="" style="rhombus;html=1;fillColor=#FFF8E1;strokeColor=#37474F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="533" y="2278" width="24" height="24" as="geometry"/></mxCell><mxCell id="c35" value="Hiển thị màn hình Thanh toán&lt;br&gt;(tổng tiền, Ví điện tử / Thẻ ngân hàng)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="2361" width="290" height="58" as="geometry"/></mxCell><mxCell id="c36" value="" style="rhombus;html=1;fillColor=#FFF8E1;strokeColor=#37474F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="178" y="2478" width="24" height="24" as="geometry"/></mxCell><mxCell id="c37" value="Chọn phương thức thanh toán&lt;br&gt;(Ví điện tử / Thẻ ngân hàng)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="2551" width="300" height="58" as="geometry"/></mxCell><mxCell id="c38" value="Nhấn &amp;quot;Xác nhận trả&amp;quot;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="2648" width="300" height="44" as="geometry"/></mxCell><mxCell id="c39" value="Gửi POST /orders (kèm JWT)&lt;br&gt;với các món trong giỏ" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="2741" width="290" height="58" as="geometry"/></mxCell><mxCell id="c40" value="Validate dữ liệu giỏ hàng&lt;br&gt;(class-validator)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1365" y="2971" width="270" height="58" as="geometry"/></mxCell><mxCell id="c41" value="Mọi món&lt;br&gt;đủ tồn kho?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1370" y="3075" width="260" height="110" as="geometry"/></mxCell><mxCell id="c42" value="Rollback, trả lỗi 400&lt;br&gt;&amp;quot;không đủ số lượng tồn kho&amp;quot;&lt;br&gt;(không tạo đơn)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1105" y="3192" width="220" height="76" as="geometry"/></mxCell><mxCell id="c43" value="Trừ tồn kho (transaction +&lt;br&gt;optimistic lock), lưu đơn&lt;br&gt;PENDING, trả mã đơn" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1365" y="3212" width="270" height="76" as="geometry"/></mxCell><mxCell id="c44" value="Hiển thị lỗi ở màn hình Thanh toán,&lt;br&gt;giữ nguyên giỏ hàng" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="3201" width="290" height="58" as="geometry"/></mxCell><mxCell id="c45" value="Thấy thông báo hết hàng" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="3208" width="300" height="44" as="geometry"/></mxCell><mxCell id="c46" value="Thử lại?&lt;br&gt;(chỉnh giỏ trước)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="3310" width="240" height="100" as="geometry"/></mxCell><mxCell id="c47" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="175" y="3455" width="30" height="30" as="geometry"/></mxCell><mxCell id="c48" value="Gửi POST /payments&lt;br&gt;(orderId, method, Idempotency-Key)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="3336" width="290" height="58" as="geometry"/></mxCell><mxCell id="c49" value="Idempotency-Key&lt;br&gt;đã được xử lý?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="3425" width="230" height="110" as="geometry"/></mxCell><mxCell id="c50" value="Trả lại kết quả đã lưu,&lt;br&gt;không thu tiền lần 2" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1105" y="3561" width="220" height="58" as="geometry"/></mxCell><mxCell id="c51" value="Xử lý giao dịch Ví / Thẻ" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1970" y="3538" width="280" height="44" as="geometry"/></mxCell><mxCell id="c52" value="Giao dịch&lt;br&gt;thành công?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1980" y="3625" width="260" height="110" as="geometry"/></mxCell><mxCell id="c53" value="Chuyển đơn PENDING → PAID,&lt;br&gt;cộng điểm tích lũy&lt;br&gt;(loyalty)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1365" y="3742" width="270" height="76" as="geometry"/></mxCell><mxCell id="c54" value="Chuyển đơn PENDING →&lt;br&gt;PAYMENT_FAILED,&lt;br&gt;không cộng điểm" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1680" y="3742" width="220" height="76" as="geometry"/></mxCell><mxCell id="c55" value="" style="rhombus;html=1;fillColor=#FFF8E1;strokeColor=#37474F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1488" y="3878" width="24" height="24" as="geometry"/></mxCell><mxCell id="c56" value="Trạng thái&lt;br&gt;đơn = PAID?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="425" y="3955" width="240" height="110" as="geometry"/></mxCell><mxCell id="c57" value="Xóa giỏ hàng,&lt;br&gt;chuyển tới /orders/{id}" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="4101" width="250" height="58" as="geometry"/></mxCell><mxCell id="c58" value="Giữ nguyên giỏ hàng,&lt;br&gt;chuyển tới /orders/{id}" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="780" y="4101" width="250" height="58" as="geometry"/></mxCell><mxCell id="c59" value="Xem màn hình xác nhận:&lt;br&gt;mã đơn, trạng thái PAID,&lt;br&gt;điểm tích lũy" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="4212" width="300" height="76" as="geometry"/></mxCell><mxCell id="c60" value="Cập nhật trạng thái theo&lt;br&gt;State Machine: PREPARING →&lt;br&gt;READY → COMPLETED" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1365" y="4332" width="270" height="76" as="geometry"/></mxCell><mxCell id="c61" value="Nhận đồ uống tại quầy" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="4458" width="300" height="44" as="geometry"/></mxCell><mxCell id="c62" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="175" y="4545" width="30" height="30" as="geometry"/></mxCell><mxCell id="c63" value="Thấy thông báo&lt;br&gt;&amp;quot;Thanh toán thất bại&amp;quot;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="4631" width="300" height="58" as="geometry"/></mxCell><mxCell id="c64" value="Thử lại?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="4730" width="240" height="100" as="geometry"/></mxCell><mxCell id="c65" value="Token hợp lệ?&lt;br&gt;(JwtAuthGuard)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1370" y="2825" width="260" height="110" as="geometry"/></mxCell><mxCell id="c66" value="Xóa token (clearToken),&lt;br&gt;chuyển về /login" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="2851" width="290" height="58" as="geometry"/></mxCell><mxCell id="c67" value="Hủy đơn?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;stro