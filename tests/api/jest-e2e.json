{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "modulePaths": ["<rootDir>/../../apps/api/node_modules"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "<rootDir>/../../apps/api/node_modules/ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.json"
      }
    ]
  }
}
