# Biến cho docker-compose (copy thành .env ở thư mục gốc nếu muốn đổi)
POSTGRES_USER=maycha
POSTGRES_PASSWORD=maycha_password
POSTGRES_DB=maycha_db
JWT_SECRET=change_me_in_production
NEXT_PUBLIC_API_URL=http://localhost:3001
# true = bật tài khoản demo (POST /dev/demo-session + nút demo ở frontend). Bản nộp để false.
ENABLE_DEMO_SEED=false
# SePay webhook/QR settings. Use a dedicated test account for test transactions.
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_API_KEY=
