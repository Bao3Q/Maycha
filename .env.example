# Biến cho docker-compose (copy thành .env ở thư mục gốc nếu muốn đổi)
POSTGRES_USER=maycha
POSTGRES_PASSWORD=maycha_password
POSTGRES_DB=maycha_db
JWT_SECRET=change_me_in_production
NEXT_PUBLIC_API_URL=http://localhost:3001
# Demo Task 9 khi chưa có đăng nhập/đặt hàng thật: bật cả backend (POST /dev/demo-session) và nút demo ở frontend
ENABLE_DEMO_SEED=true
